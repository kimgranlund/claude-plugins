{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/doc_lint.py\" --hook",
            "timeout": 15,
            "statusMessage": "doc-postwrite-lint"
          }
        ]
      }
    ]
  }
}
