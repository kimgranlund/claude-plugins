{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Write(.claude/ops/watch-checkpoint.json)",
      "Write(.claude/ops/friendlies.json)",
      "Write(.claude/ops/held-items.md)",
      "Write(.claude/ops/reports/*.md)",
      "Bash(python3 harness/scripts/skill_lint.py *)",
      "Bash(python3 harness/scripts/release_gate.py *)",
      "Bash(python3 harness/scripts/eval_check.py *)",
      "Bash(python3 harness/scripts/docs_check.py *)",
      "Bash(python3 harness/scripts/corpus_check.py *)",
      "Bash(python3 docs/scripts/doc_lint.py *)",
      "Bash(python3 authorkit/skills/naming-audit/scripts/validate.py *)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__plugin_figma_figma__get_screenshot",
      "mcp__plugin_figma_figma__get_metadata"
    ]
  },
  "enabledPlugins": {
    "harness@nonoun-plugins": true,
    "docs@nonoun-plugins": true,
    "teamwork@nonoun-plugins": true,
    "authorkit@nonoun-plugins": true,
    "screens@nonoun-plugins": true,
    "agent-protocols@nonoun-plugins": true,
    "llm@nonoun-plugins": true,
    "design@nonoun-plugins": true
  },
  "extraKnownMarketplaces": {
    "nonoun-plugins": {
      "source": {
        "source": "github",
        "repo": "kimgranlund/claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "for p in harness docs teamwork screens design agent-protocols llm authorkit; do out=$(python3 \"$CLAUDE_PROJECT_DIR/authorkit/skills/naming-audit/scripts/validate.py\" --target \"$CLAUDE_PROJECT_DIR/$p\" --manifest \"$CLAUDE_PROJECT_DIR/naming.manifest.json\" --hook --scope grammar 2>&1); rc=$?; if [ \"$rc\" -ne 0 ]; then echo \"$out\" >&2; exit 2; fi; done",
            "timeout": 20,
            "statusMessage": "naming-postwrite-grammar-gate"
          }
        ]
      }
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "A dispatched build-lead/teammate subagent may run gh pr merge when its own sealed dispatch prompt contains the literal line auto-merge: authorized, AND the PR CI checks are green, AND release_gate.py passed locally for the touched plugin \u2014 this is the ADR-0012 quick-build fast path (kimgranlund/claude-plugins), never a general merge grant to subagents."
    ]
  }
}