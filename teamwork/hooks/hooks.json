{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/worktree_prebash_guard.py\" --hook",
            "timeout": 10,
            "statusMessage": "worktree-prebash-guard"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_end_worktree_check.py\" --hook",
            "timeout": 10,
            "statusMessage": "session-end-worktree-check"
          }
        ]
      }
    ]
  }
}
